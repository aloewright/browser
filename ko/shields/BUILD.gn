import("//brave/components/ko/buildflags/buildflags.gni")
import("//brave/resources/brave_grit.gni")

assert(is_ko)

# Embedded filter list snapshot; regenerate with update_lists.py.
brave_grit("resources") {
  source = "ko_shields_resources.grd"
  outputs = [
    "grit/ko_shields_resources.h",
    "ko_shields_resources.pak",
  ]
}

# id -> IDR table generated alongside the grd.
source_set("embedded_lists") {
  sources = [ "ko_embedded_lists.inc" ]
  public_deps = [ ":resources" ]
}
