# Pinned PostHog release (hobby compose files and app images).
# Bump deliberately: review upstream docker-compose.hobby.yml changes first.
POSTHOG_COMMIT=5f3ddee5e99fb1ea258e617bf461e01ec28fb813
REGISTRY_URL=posthog/posthog
POSTHOG_APP_TAG=5f3ddee5e99fb1ea258e617bf461e01ec28fb813
NODE_IMAGES_REGISTRY_URL=ghcr.io/posthog/posthog-node
POSTHOG_NODE_TAG=5f3ddee5e99fb1ea258e617bf461e01ec28fb813
# Compose-time Caddyfile inputs (upstream's deploy-hobby writes them to .env):
# plain HTTP on :80, TLS is terminated by the private reverse proxy.
CADDY_HOST="http://:80"
CADDY_TLS_BLOCK="auto_https off"
