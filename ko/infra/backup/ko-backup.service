[Unit]
Description=K-O telemetry backups (GlitchTip, PostHog)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# BACKUP_DIR, BACKUP_AGE_RECIPIENT (public key), POSTHOG_DIR.
EnvironmentFile=/etc/ko-infra/backup.env
ExecStart=/opt/ko-infra/backup/backup.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
