# Authenticated SOCKS5/HTTP proxy on this peer's NetBird IP, chained to
# Bright Data. Install with install.sh; see ko/docs/infra.md.
[Unit]
Description=K-O residential proxy (gost -> Bright Data) on NetBird
Wants=network-online.target
After=network-online.target netbird.service

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=ko-proxy
RuntimeDirectoryMode=0700
Environment=HOME=/run/ko-proxy
# DOPPLER_TOKEN=<read-only service token for the ko-proxy config>; root 0600.
EnvironmentFile=/etc/ko-proxy/doppler.env
# The rendered config is a one-read FIFO on tmpfs; Doppler's cache stays there too.
ExecStart=/usr/bin/doppler --config-dir /run/ko-proxy/doppler run \
  --mount /run/ko-proxy/gost.yaml \
  --mount-template /etc/ko-proxy/gost.yaml.tmpl \
  --mount-max-reads 1 \
  -- /usr/local/bin/gost -C /run/ko-proxy/gost.yaml
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
