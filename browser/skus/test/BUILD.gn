import("//brave/components/ko/buildflags/buildflags.gni")

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  # K-O compiles the SKU service out, so the JS API has nothing to call.
  sources = []
  if (is_ko) {
    sources += [ "skus_ko_browsertest.cc" ]
  } else {
    sources += [ "js_skus_api_browsertest.cc" ]
  }

  deps = [
    "//base/test:test_support",
    "//brave/browser",
    "//brave/browser/skus",
    "//brave/components/skus/browser",
    "//brave/components/skus/common",
    "//brave/components/skus/common:mojom",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_test_utils",
    "//components/prefs",
    "//content/public/common",
    "//content/test:test_support",
    "//net:test_support",
    "//services/network/public/cpp",
  ]

  if (is_android) {
    deps += [ "//chrome/test:test_support_ui_android" ]
  } else {
    deps += [ "//chrome/test:test_support_ui" ]
  }
}
