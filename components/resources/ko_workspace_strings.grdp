<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
  <message name="IDS_KO_WORKSPACE_TITLE" desc="K-O workspace: Page title" formatter_data="webui=KoWorkspace">
    Workspaces
  </message>
  <message name="IDS_KO_WORKSPACE_AGENTD_OFFLINE" desc="K-O workspace: ko-agentd is not reachable" formatter_data="webui=KoWorkspace">
    ko-agentd isn't running. Start it, then reload this page.
  </message>
  <message name="IDS_KO_WORKSPACE_TOKEN_MISSING" desc="K-O workspace: The agentd token file is missing" formatter_data="webui=KoWorkspace">
    No agentd token found. Run ko-agentd once to create it, then reload.
  </message>
  <message name="IDS_KO_WORKSPACE_TOKEN_INSECURE" desc="K-O workspace: The agentd token file has loose permissions" formatter_data="webui=KoWorkspace">
    The agentd token file can be read by other users. Run chmod 600 on it, then reload.
  </message>
  <message name="IDS_KO_WORKSPACE_TOKEN_INVALID" desc="K-O workspace: The agentd token file is malformed" formatter_data="webui=KoWorkspace">
    The agentd token file is malformed. Run ko-agentd token rotate, then reload.
  </message>
  <message name="IDS_KO_WORKSPACE_RELOAD" desc="K-O workspace: Button that reloads the page" formatter_data="webui=KoWorkspace">
    Reload
  </message>
  <message name="IDS_KO_WORKSPACE_SHOW_IN_SIDE_PANEL" desc="K-O workspace: Button that opens the workspace page in the side panel" formatter_data="webui=KoWorkspace">
