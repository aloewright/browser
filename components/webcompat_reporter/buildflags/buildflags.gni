import("//brave/components/brave_debloat/buildflags/buildflags.gni")

declare_args() {
  # Empty disables report submission.
  if (is_brave_debloated) {
    webcompat_report_api_endpoint = ""
  } else {
    webcompat_report_api_endpoint = "https://webcompat.brave.com/1/webcompat"
  }
}
