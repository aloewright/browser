import("//brave/components/ko/buildflags/buildflags.gni")

assert(is_ko)

static_library("browser") {
  sources = [
    "credential_store.cc",
    "credential_store.h",
    "machine_address_resolver.cc",
    "machine_address_resolver.h",
    "machine_bridge.cc",
    "machine_bridge.h",
    "machines_handler.cc",
    "machines_handler.h",
  ]

  public_deps = [
    "//base",
    "//brave/components/ko/machines/common:mojom",
    "//brave/components/ko/machines/core",
    "//components/prefs",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/mojom",
    "//services/network/public/mojom:mojom_host_resolver",
  ]

  deps = [
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "credential_store_unittest.cc",
    "machine_address_resolver_unittest.cc",
    "machine_bridge_unittest.cc",
    "machines_handler_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//brave/components/ko/machines/common:mojom",
    "//brave/components/ko/machines/core",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/browser:test_support",
    "//components/os_crypt/async/common",
    "//components/prefs",
    "//components/prefs:test_support",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//net:test_support",
    "//services/network:test_support",
    "//services/network/public/mojom",
    "//testing/gtest",
  ]
}
