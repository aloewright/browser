import("//brave/components/ko/buildflags/buildflags.gni")

assert(is_ko)

static_library("core") {
  sources = [
    "agentd_config.cc",
    "agentd_config.h",
    "workspace_apps.cc",
    "workspace_apps.h",
  ]

  public_deps = [
    "//base",
    "//url",
  ]

  deps = [ "//components/prefs" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "agentd_config_unittest.cc",
    "workspace_apps_unittest.cc",
  ]

  deps = [
    ":core",
    "//base",
    "//base/test:test_support",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//url",
  ]
}
