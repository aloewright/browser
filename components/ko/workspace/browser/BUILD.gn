import("//brave/components/ko/buildflags/buildflags.gni")

assert(is_ko)

static_library("browser") {
  sources = [
    "ko_workspace_handler.cc",
    "ko_workspace_handler.h",
  ]

  public_deps = [
    "//brave/components/ko/workspace/common:mojom",
    "//brave/components/ko/workspace/core",
    "//mojo/public/cpp/bindings",
    "//url",
  ]

  deps = [
    "//base",
    "//components/prefs",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "ko_workspace_handler_unittest.cc" ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//brave/components/ko/workspace/core",
    "//components/prefs:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
    "//url",
  ]
}
