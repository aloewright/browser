import("//brave/components/brave_origin/buildflags/buildflags.gni")
import("//brave/components/ko/buildflags/buildflags.gni")

declare_args() {
  # K-O re-enables it with BYO providers only (ko/docs/assistant.md).
  enable_ai_chat = !is_brave_origin_branded && (!is_brave_debloated || is_ko)
}

declare_args() {
  enable_brave_ai_chat_agent_profile = enable_ai_chat && !is_android
  enable_ai_chat_tab_management_tool = enable_ai_chat && !is_android
}
