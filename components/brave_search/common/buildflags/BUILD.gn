import("//brave/components/brave_debloat/buildflags/buildflags.gni")
import("//build/buildflag_header.gni")

declare_args() {
  service_key_search = ""
}

# Forks lack Brave's private service keys; Brave endpoints may reject
# keyless requests (see debloat/README.md).
if (is_official_build && !is_brave_debloated) {
  assert(service_key_search != "")
}

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [ "SERVICE_KEY_SEARCH=\"$service_key_search\"" ]
}
